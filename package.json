{
  "name": "frontier-browser",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source, voice-first browser for blind and low-vision people. Bring your own AI model — or none.",
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "cli": "npm run start -w @frontier/cli --",
    "desktop": "npm run start -w @frontier/desktop",
    "check:distribution": "node scripts/check-no-distribution.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
